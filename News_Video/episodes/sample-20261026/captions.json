[
  {
    "id": "caption-0-0",
    "text": "这是一条本地资讯样片。",
    "start": 0.0,
    "end": 1.7699999999999998
  },
  {
    "id": "caption-1-0",
    "text": "先看人工智能动态，再看国内外新闻。",
    "start": 1.99,
    "end": 5.58
  },
  {
    "id": "caption-2-0",
    "text": "所有条目都保留来源和日期。",
    "start": 5.8,
    "end": 7.75
  },
  {
    "id": "caption-3-0",
    "text": "克劳德代码助手更新到二点一点三一零版本。",
    "start": 7.97,
    "end": 12.059999999999999
  },
  {
    "id": "caption-4-0",
    "text": "官方更新记录列出了监控工具支持，以及网关兼容和文",
    "start": 12.28,
    "end": 18.032258064516128
  },
  {
    "id": "caption-4-1",
    "text": "件清理等修复。",
    "start": 18.032258064516128,
    "end": 19.71
  },
  {
    "id": "caption-5-0",
    "text": "开放人工智能公司发布存储系统扩展的工程文章。",
    "start": 19.93,
    "end": 24.77
  },
  {
    "id": "caption-6-0",
    "text": "官方介绍了多租户和全球缓存等方案，并报告读取性能",
    "start": 24.99,
    "end": 30.549999999999997
  },
  {
    "id": "caption-6-1",
    "text": "提升十二倍。",
    "start": 30.549999999999997,
    "end": 31.939999999999998
  },
  {
    "id": "caption-7-0",
    "text": "这是工程指标，不代表模型回答速度。",
    "start": 32.16,
    "end": 35.4
  },
  {
    "id": "caption-8-0",
    "text": "同一天，开放人工智能公司还介绍了训练与评估环境的",
    "start": 35.62,
    "end": 40.993658536585365
  },
  {
    "id": "caption-8-1",
    "text": "隔离措施，包括离线环境与安全测试。",
    "start": 40.993658536585365,
    "end": 44.8
  },
  {
    "id": "caption-9-0",
    "text": "本条只概述公开的防护方向。",
    "start": 45.019999999999996,
    "end": 48.019999999999996
  },
  {
    "id": "caption-10-0",
    "text": "艾伦人工智能研究所团队介绍了一个研究构思工具。",
    "start": 48.239999999999995,
    "end": 52.97
  },
  {
    "id": "caption-11-0",
    "text": "它把问题、贡献和评估方案分别关联到文献，并提供有",
    "start": 53.19,
    "end": 58.44
  },
  {
    "id": "caption-11-1",
    "text": "依据的修改建议。",
    "start": 58.44,
    "end": 60.19
  },
  {
    "id": "caption-12-0",
    "text": "研究者仍然决定是否采用。",
    "start": 60.41,
    "end": 63.8
  },
  {
    "id": "caption-13-0",
    "text": "国内方面，国家能源局消息显示，截至九月底，风电和",
    "start": 64.02,
    "end": 69.4953488372093
  },
  {
    "id": "caption-13-1",
    "text": "太阳能发电累计装机达到二十点一亿千瓦。",
    "start": 69.4953488372093,
    "end": 73.83
  },
  {
    "id": "caption-14-0",
    "text": "这里说的是装机容量，不能直接当作实际发电量。",
    "start": 74.05,
    "end": 78.67
  },
  {
    "id": "caption-15-0",
    "text": "力箭二号遥二运载火箭已转运到发射工位，进入发射前",
    "start": 78.89,
    "end": 83.69827586206897
  },
  {
    "id": "caption-15-1",
    "text": "准备阶段。",
    "start": 83.69827586206897,
    "end": 84.7
  },
  {
    "id": "caption-16-0",
    "text": "后续还要进行接口和全流程演练。",
    "start": 84.92,
    "end": 88.5
  },
  {
    "id": "caption-17-0",
    "text": "转运完成并不等于已经发射成功。",
    "start": 88.72,
    "end": 92.33
  },
  {
    "id": "caption-18-0",
    "text": "一则居家养老报道关注了上门照护、社区助餐和智能照",
    "start": 92.55,
    "end": 97.43516129032258
  },
  {
    "id": "caption-18-1",
    "text": "护产品的应用。",
    "start": 97.43516129032258,
    "end": 98.86
  },
  {
    "id": "caption-19-0",
    "text": "各地的服务条件和补贴标准不同，具体办理仍要核对当",
    "start": 99.08,
    "end": 103.61428571428571
  },
  {
    "id": "caption-19-1",
    "text": "地规定。",
    "start": 103.61428571428571,
    "end": 104.37
  },
  {
    "id": "caption-20-0",
    "text": "国际方面，大熊猫冉冉将赴比利时，继续参加大熊猫保",
    "start": 104.59,
    "end": 109.406
  },
  {
    "id": "caption-20-1",
    "text": "护研究合作。",
    "start": 109.406,
    "end": 110.61
  },
  {
    "id": "caption-21-0",
    "text": "目前有关单位正在落实饲养管理安排，开展出发前的准",
    "start": 110.83,
    "end": 116.88142857142857
  },
  {
    "id": "caption-21-1",
    "text": "备工作。",
    "start": 116.88142857142857,
    "end": 117.89
  },
  {
    "id": "caption-22-0",
    "text": "中新网援引尼泊尔媒体报道，九月中旬至十月中旬，尼",
    "start": 118.11,
    "end": 123.09418604651162
  },
  {
    "id": "caption-22-1",
    "text": "泊尔对印度出口电力约六点三四亿千瓦时。",
    "start": 123.09418604651162,
    "end": 127.03999999999999
  },
  {
    "id": "caption-23-0",
    "text": "这是特定统计区间的数据，不是当天的出口量。",
    "start": 127.26,
    "end": 131.27
  },
  {
    "id": "caption-24-0",
    "text": "本期可用的国际安全候选不足三条，因此保留两条。",
    "start": 131.49,
    "end": 137.33
  },
  {
    "id": "caption-25-0",
    "text": "人工智能动态回看了七十二小时，画面保留原始日期。",
    "start": 137.55,
    "end": 142.36
  },
  {
    "id": "caption-26-0",
    "text": "样片到这里结束。",
    "start": 142.58,
    "end": 144.84
  }
]